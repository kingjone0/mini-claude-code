  "patch": "diff --git a/src/click/core.py b/src/click/core.py\nindex f57ada62b195fa533387b5d06b366b17edb7d2f4..ca019b8198afda7dacdf6c4e0440fddf7e23252f 100644\n--- a/src/click/core.py\n+++ b/src/click/core.py\n@@ -2676,7 +2676,7 @@ class Option(Parameter):\n \n     def get_error_hint(self, ctx: Context) -> str:\n         result = super().get_error_hint(ctx)\n-        if self.show_envvar:\n+        if self.show_envvar and self.envvar is not None:\n             result += f\" (env var: '{self.envvar}')\"\n         return result\n \n",
