# ── 内层 Agent 的 API runtime 配置模板 ─────────────────────────────
# 用法：cp .env.example .env  然后把值填上。
#
# 这是**唯一**的 API 配置来源（见 hello_agent.py / hello_agent_stdio.py 的
# load_endpoint_env）。脚本不再读 ~/.claude/settings.json，也会主动摘掉父进程
# 继承来的 ANTHROPIC_* / API_TIMEOUT* —— 缺什么就报什么，不静默回落：
#
#     交互式 Claude Code  →  ~/.claude/settings.json
#     实验脚本（内层 Agent）→  本文件
#
# 切开是为了归因：第三方端点的账单只给总额，不分 key 就回答不了
# 「这次实验花了多少」，第三阶段跑 SWE-bench 消融正是要这个粒度。
#
# 写法：`KEY=VALUE` 和 `KEY = VALUE` 都支持，等号两边会被 strip；
# 值两端的成对引号会被去掉。

# ── 必填 ─────────────────────────────────────────────────────────
# 凭据：下面两个**二选一**，填一个即可。值只写在这里，别提交（.env 已被忽略）。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# 端点。不填会打到 api.anthropic.com 去，而报错文案会误导成「模型不存在」
# （见项目 CLAUDE.md 陷阱 3）—— 所以脚本把这一项列为必填，缺了直接报错。
# 例：https://<你的 Anthropic 兼容端点>/anthropic
ANTHROPIC_BASE_URL=

# 主模型。显式钉住是有意的：缺省值会随 CLI 版本变，钉不住就谈不上消融对比。
# 例：<你的模型名>
ANTHROPIC_MODEL=

# ── 选填（不填也能跑，会退回 CLI 自带缺省值）──────────────────────
# 补上的两个理由：
#   1) 与迁移前行为一致；
#   2) Claude Code 每次运行都会额外调一次 generate_session_title（陷阱 4），
#      那次走的是 HAIKU 档 —— 不钉住它，成本核算对不上账。
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
API_TIMEOUT_MS=

# ── 下面两个是脚本的开关，不是本文件的键，别写进来 ─────────────────
#   DOTENV_PATH=<文件>       换 .env 的位置（做对照实验，不必动真正的 .env）
#   HELLO_AGENT_BASE_URL=<url>  覆盖 ANTHROPIC_BASE_URL（反向对照用）
